{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Food Security by Income",
    "subtitle": "The lowest income quintile has the clearest food-insecurity gap.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "limit": 520,
    "subtitleLimit": 560,
    "offset": 10
  },
  "config": {
    "font": "Inter",
    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelLimit": 180,
      "labelPadding": 5
    },
    "view": {
      "stroke": null
    }
  },
  "width": "container",
  "height": 350,
  "data": {
    "url": "data/cleaned/barriers_to_healthy_eating.csv"
  },
  "encoding": {
    "y": {
      "field": "income_group",
      "type": "nominal",
      "sort": [
        "Lowest income quintile",
        "2nd quintile",
        "3rd quintile",
        "4th quintile",
        "Highest income quintile"
      ],
      "title": "Income group"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "rule",
        "strokeWidth": 4,
        "color": "#ccd7cf"
      },
      "encoding": {
        "x": {
          "field": "food_insecure",
          "type": "quantitative",
          "title": "Households (%)",
          "scale": {
            "domain": [
              0,
              100
            ]
          }
        },
        "x2": {
          "field": "food_secure"
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "color": "#c7432f"
      },
      "encoding": {
        "x": {
          "field": "food_insecure",
          "type": "quantitative",
          "title": "Households (%)"
        },
        "tooltip": [
          {
            "field": "income_group",
            "title": "Income group"
          },
          {
            "field": "food_insecure",
            "title": "Food-insecure households (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 170,
        "color": "#2e7d62"
      },
      "encoding": {
        "x": {
          "field": "food_secure",
          "type": "quantitative",
          "title": "Households (%)"
        },
        "tooltip": [
          {
            "field": "income_group",
            "title": "Income group"
          },
          {
            "field": "food_secure",
            "title": "Food-secure households (%)",
            "format": ".1f"
          }
        ]
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared"
    }
  },
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "padding": {
    "top": 18,
    "right": 18,
    "bottom": 12,
    "left": 12
  }
}
