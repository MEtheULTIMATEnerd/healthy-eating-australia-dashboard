{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Healthy Eating Compliance Remains Extremely Low",
    "subtitle": "Across all survey years, only around 4–5% of Australians met both fruit and vegetable recommendations.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "limit": 700,
    "subtitleLimit": 800,
    "offset": 10
  },

  "config": {
    "font": "Inter",

    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 5
    },

    "view": {
      "stroke": null
    }
  },

  "width": "container",
  "height": 320,

  "data": {
    "url": "data/cleaned/food_awareness.csv"
  },

  "transform": [
    {
      "filter": "datum.metric == 'Did not meet fruit and vegetable recommendation'"
    },
    {
      "calculate": "100 - datum.percent",
      "as": "met_percent"
    }
  ],

  "encoding": {
    "x": {
      "field": "year",
      "type": "quantitative",
      "title": "Survey year",
      "axis": {
        "format": "d",
        "tickMinStep": 1
      }
    }
  },

  "layer": [

    {
      "mark": {
        "type": "area",
        "color": "#e66a35",
        "opacity": 0.18
      },

      "encoding": {
        "y": {
          "field": "percent",
          "type": "quantitative",
          "title": "Share of population (%)",
          "scale": {
            "domain": [0, 100]
          }
        },

        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "percent",
            "title": "Did not meet recommendation (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "area",
        "color": "#2e7d62",
        "opacity": 0.85
      },

      "encoding": {
        "y": {
          "field": "met_percent",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "year",
            "title": "Year",
            "format": "d"
          },
          {
            "field": "met_percent",
            "title": "Met recommendation (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "line",
        "stroke": "#24302d",
        "strokeWidth": 3
      },

      "encoding": {
        "y": {
          "field": "met_percent",
          "type": "quantitative"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "category": "Met recommendation"
          },
          {
            "category": "Did not meet recommendation"
          }
        ]
      },

      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0
      },

      "encoding": {
        "color": {
          "field": "category",
          "type": "nominal",
          "title": "Recommendation status",
          "scale": {
            "domain": [
              "Met recommendation",
              "Did not meet recommendation"
            ],
            "range": [
              "#2e7d62",
              "#f3b79d"
            ]
          },
          "legend": {
            "title": "Recommendation status",
            "orient": "bottom",
            "direction": "horizontal",
            "columns": 2,
            "symbolType": "circle",
            "symbolSize": 100,
            "titleFontSize": 12,
            "labelFontSize": 12,
            "labelLimit": 500
          }
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "x": 2018,
            "y": 12,
            "label": "Compliance never exceeded 5.4%"
          }
        
        ]
      },

      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": 700,
        "fill": "#2e7d62",
        "align": "center"
      },

      "encoding": {
        "x": {
          "field": "x",
          "type": "quantitative"
        },

        "y": {
          "field": "y",
          "type": "quantitative"
        },

        "text": {
          "field": "label"
        }
      }
    }

  ],

  "padding": {
    "top": 18,
    "right": 18,
    "bottom": 12,
    "left": 12
  }
}