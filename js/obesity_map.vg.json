{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "background": "transparent",

  "title": {
    "text": "Adult Obesity by State",
    "subtitle": "State-level obesity rates across Australia.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "color": "#1f2724",
    "subtitleColor": "#61706a",
    "limit": 520,
    "subtitleLimit": 660,
    "offset": 10
  },

  "config": {
    "font": "Inter",

    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10
    },

    "view": {
      "stroke": null,
      "fill": "transparent"
    },

    "legend": {
      "orient": "bottom",
      "titleColor": "#24302d",
      "labelColor": "#46524f",
      "titleFontSize": 12,
      "labelFontSize": 12
    }
  },

  "width": "container",
  "height": 420,

  "projection": {
    "type": "mercator",
    "center": [134, -28.5],
    "scale": 430
  },

  "layer": [

    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "transform": [
        {
          "calculate": "datum.properties.STATE_NAME",
          "as": "state_name"
        },

        {
          "lookup": "state_name",
          "from": {
            "data": {
              "url": "data/cleaned/obesity_by_state.csv"
            },
            "key": "state",
            "fields": [
              "obesity_rate",
              "overweight_obese_rate"
            ]
          }
        },

        {
          "filter": "isValid(datum.obesity_rate)"
        }
      ],

      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 1.2
      },

      "encoding": {
        "color": {
          "field": "obesity_rate",
          "type": "quantitative",
          "title": "Adult obesity rate (%)",
          "scale": {
            "domain": [29, 37],
            "range": [
              "#dceee4",
              "#9fc7cd",
              "#7f7aa8",
              "#4b345f"
            ]
          },
          "legend": {
            "gradientLength": 220
          }
        },

        "tooltip": [
          {
            "field": "state_name",
            "title": "State"
          },
          {
            "field": "obesity_rate",
            "title": "Adult obesity rate (%)",
            "format": ".1f"
          },
          {
            "field": "overweight_obese_rate",
            "title": "Overweight or obese (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "data": {
        "url": "data/states.geojson",
        "format": {
          "type": "json",
          "property": "features"
        }
      },

      "mark": {
        "type": "geoshape",
        "fill": null,
        "stroke": "#24302d",
        "strokeWidth": 0.9
      }
    },

    {
      "data": {
        "values": [
          { "label": "WA", "lon": 121.2, "lat": -25.5 },
          { "label": "NT", "lon": 133.5, "lat": -19.5 },
          { "label": "SA", "lon": 135.5, "lat": -30.2 },
          { "label": "QLD", "lon": 145.0, "lat": -21.5 },
          { "label": "NSW", "lon": 147.2, "lat": -32.8 },
          { "label": "VIC", "lon": 144.4, "lat": -37.2 },
          { "label": "ACT", "lon": 149.1, "lat": -35.3 }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 9,
        "fontWeight": 600,
        "fill": "#3f4a46",
        "opacity": 0.75
      },

      "encoding": {
        "longitude": { "field": "lon" },
        "latitude": { "field": "lat" },
        "text": { "field": "label" }
      }
    },

    {
      "data": {
        "values": [
          {
            "lon1": 146.6,
            "lat1": -42.0,
            "lon2": 150.2,
            "lat2": -41.0
          }
        ]
      },

      "mark": {
        "type": "rule",
        "stroke": "#3f4a46",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": { "field": "lon1" },
        "latitude": { "field": "lat1" },
        "longitude2": { "field": "lon2" },
        "latitude2": { "field": "lat2" }
      }
    },

    {
      "data": {
        "values": [
          {
            "label": "TAS",
            "lon": 150.6,
            "lat": -40.8
          }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "fill": "#24302d"
      },

      "encoding": {
        "longitude": { "field": "lon" },
        "latitude": { "field": "lat" },
        "text": { "field": "label" }
      }
    },

    {
      "data": {
        "values": [
          {
            "label": "Lower obesity despite\nhigher population density",
            "lon": 127,
            "lat": -38.5
          }
        ]
      },

      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "fill": "#24302d",
        "align": "center"
      },

      "encoding": {
        "longitude": { "field": "lon" },
        "latitude": { "field": "lat" },
        "text": { "field": "label" }
      }
    },

    {
      "data": {
        "values": [
          {
            "lon1": 142.2,
            "lat1": -38.4,
            "lon2": 146.8,
            "lat2": -36.0
          }
        ]
      },

      "mark": {
        "type": "rule",
        "stroke": "#24302d",
        "strokeWidth": 1
      },

      "encoding": {
        "longitude": { "field": "lon1" },
        "latitude": { "field": "lat1" },
        "longitude2": { "field": "lon2" },
        "latitude2": { "field": "lat2" }
      }
    }

  ],

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "padding": {
    "top": 18,
    "right": 18,
    "bottom": 12,
    "left": 12
  }
}