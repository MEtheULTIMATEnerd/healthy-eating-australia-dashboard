{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Sweetened Beverage Consumption Across Income Groups",
    "subtitle": "Child and adult sweetened beverage consumption across income quintiles.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "limit": 600,
    "subtitleLimit": 1000,
    "offset": 10
  },

  "config": {
    "font": "Inter",

    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelPadding": 5
    },

    "view": {
      "stroke": null
    }
  },

  "width": "container",
  "height": 340,

  "data": {
    "url": "data/cleaned/heatmap_age_income.csv"
  },

  "transform": [
    {
      "calculate": "datum.age_group == 'Children 2-17' ? 'Children' : 'Adults'",
      "as": "age_short"
    },

    {
      "pivot": "age_short",
      "value": "selected_beverage_percent",
      "groupby": ["income_group"]
    },

    {
      "calculate": "datum.income_group == 'First' ? 1 : datum.income_group == 'Second' ? 2 : datum.income_group == 'Third' ? 3 : datum.income_group == 'Fourth' ? 4 : 5",
      "as": "income_order"
    }
  ],

  "layer": [

    {
      "mark": {
        "type": "line",
        "stroke": "#bfc9c3",
        "strokeWidth": 3,
        "point": false
      },

      "encoding": {
        "x": {
          "field": "Adults",
          "type": "quantitative",
          "title": "Adults 18+ consuming selected beverages (%)",
          "scale": {
            "domain": [30, 40]
          }
        },

        "y": {
          "field": "Children",
          "type": "quantitative",
          "title": "Children 2–17 consuming selected beverages (%)",
          "scale": {
            "domain": [25, 40]
          }
        },

        "order": {
          "field": "income_order"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.income_group == 'Second'"
        }
      ],

      "mark": {
        "type": "circle",
        "filled": false,
        "size": 520,
        "stroke": "#e66a35",
        "strokeWidth": 3
      },

      "encoding": {
        "x": {
          "field": "Adults",
          "type": "quantitative"
        },

        "y": {
          "field": "Children",
          "type": "quantitative"
        }
      }
    },

    {
      "data": {
        "values": [
          {
            "Adults": 38.9,
            "Children": 30.2,
            "label": "Largest child–adult gap"
          }
        ]
      },

      "mark": {
        "type": "text",
        "align": "left",
        "dx": -145,
        "dy": 10,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#24302d"
      },

      "encoding": {
        "x": {
          "field": "Adults",
          "type": "quantitative"
        },

        "y": {
          "field": "Children",
          "type": "quantitative"
        },

        "text": {
          "field": "label"
        }
      }
    },

    {
      "mark": {
        "type": "circle",
        "filled": true,
        "size": 180,
        "color": "#2e7d62",
        "stroke": "white",
        "strokeWidth": 2
      },

      "encoding": {
        "x": {
          "field": "Adults",
          "type": "quantitative"
        },

        "y": {
          "field": "Children",
          "type": "quantitative"
        },

        "tooltip": [
          {
            "field": "income_group",
            "title": "Income quintile"
          },
          {
            "field": "Adults",
            "title": "Adults (%)",
            "format": ".1f"
          },
          {
            "field": "Children",
            "title": "Children (%)",
            "format": ".1f"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "dx": 8,
        "dy": -8,
        "fontSize": 12,
        "fontWeight": 700,
        "color": "#24302d"
      },

      "encoding": {
        "x": {
          "field": "Adults",
          "type": "quantitative"
        },

        "y": {
          "field": "Children",
          "type": "quantitative"
        },

        "text": {
          "field": "income_group"
        }
      }
    }

  ],


  "padding": {
    "top": 40,
    "right": 24,
    "bottom": 12,
    "left": 12
  }
}