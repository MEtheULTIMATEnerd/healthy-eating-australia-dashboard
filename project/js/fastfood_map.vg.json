{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Top Fast-Food Chains in Australia",
    "subtitle": "Top 10 chains by recorded OSM brand count.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "color": "#1f2724",
    "subtitleColor": "#61706a",
    "limit": 520,
    "subtitleLimit": 600,
    "offset": 10
  },

  "config": {
    "font": "Inter",

    "view": {
      "stroke": null
    },

    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelLimit": 190,
      "labelPadding": 5
    }
  },

  "width": "container",
  "height": 410,

  "data": {
    "url": "data/cleaned/top_fastfood_chains.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 5,
        "color": "#e66a35"
      },

      "encoding": {
        "y": {
          "field": "chain",
          "type": "nominal",
          "sort": {
            "field": "outlets",
            "order": "descending"
          },
          "title": "Fast-food chain"
        },

        "x": {
          "field": "outlets",
          "type": "quantitative",
          "title": "Number of mapped outlets"
        },

        "tooltip": [
          {
            "field": "chain",
            "title": "Fast-food chain"
          },
          {
            "field": "outlets",
            "title": "Mapped outlets",
            "format": ","
          },
          {
            "field": "coverage_note",
            "title": "Coverage note"
          }
        ]
      }
    },

    {
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 5,
        "fontSize": 11,
        "fontWeight": 700,
        "color": "#35413d"
      },

      "encoding": {
        "y": {
          "field": "chain",
          "type": "nominal",
          "sort": {
            "field": "outlets",
            "order": "descending"
          }
        },

        "x": {
          "field": "outlets",
          "type": "quantitative"
        },

        "text": {
          "field": "outlets",
          "type": "quantitative"
        }
      }
    }
  ],

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "padding": {
    "top": 18,
    "right": 20,
    "bottom": 12,
    "left": 12
  }
}