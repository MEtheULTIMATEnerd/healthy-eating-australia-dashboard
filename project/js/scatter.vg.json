{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Fast-Food Exposure and Obesity Outcomes",
    "subtitle": "Fast-food outlet density alone does not explain obesity differences across Australian states.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "offset": 10
  },

  "config": {
    "font": "Inter",

    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titlePadding": 10
    },

    "view": {
      "stroke": null
    },

    "legend": {
      "orient": "bottom",
      "titleFontSize": 12,
      "labelFontSize": 12,
      "symbolSize": 90
    }
  },

  "width": "container",
  "height": 350,
  "spacing": 18,

  "data": {
    "url": "data/cleaned/obesity_fastfood_merged.csv"
  },

  "layer": [
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "opacity": 0.85,
        "stroke": "white",
        "strokeWidth": 1
      },

      "encoding": {

        "x": {
          "field": "fast_food_outlets",
          "type": "quantitative",
          "title": "Mapped fast-food outlets",
          "scale": {
            "domain": [0, 4000]
          }
        },

        "y": {
          "field": "obesity_rate",
          "type": "quantitative",
          "title": "Adult obesity rate (%)",
          "scale": {
            "domain": [29,37.5]
          }
        },

        "size": {
          "field": "overweight_obese_rate",
          "type": "quantitative",
          "title": "Overweight or obese (%)",
          "scale": {
            "domain": [63,71],
            "range": [250,2200]
          },
          "legend": {
            "orient": "bottom",
            "values": [63,65,67,69,71]
          }
        },

        "color": {
          "field": "urban_regional",
          "type": "nominal",
          "title": "State context",
          "scale": {
            "range": [
              "#2f9c95",
              "#4b345f"
            ]
          },
          "legend": {
            "orient": "bottom"
          }
        },

        "tooltip": [
          {
            "field": "state",
            "title": "State"
          },
          {
            "field": "fast_food_outlets",
            "title": "Fast-food outlets"
          },
          {
            "field": "obesity_rate",
            "title": "Adult obesity rate (%)"
          },
          {
            "field": "overweight_obese_rate",
            "title": "Overweight or obese (%)"
          }
        ]
      }
    },

    {
      "transform": [
        {
          "calculate": "upper(datum.abbr)",
          "as": "abbr_upper"
        }
      ],
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 12,
        "fontWeight": 900,
        "color": "#24302d"
      },

      "encoding": {
        "x": {
          "field": "fast_food_outlets",
          "type": "quantitative"
        },

        "y": {
          "field": "obesity_rate",
          "type": "quantitative"
        },

        "text": {
          "field": "abbr_upper"
        }
      }
    },

    {
      "transform": [
        {
          "filter": "datum.state == 'Victoria'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": -80,
        "dy": -40,
        "align": "left",
        "fontSize": 11,
        "fontWeight": 800,
        "color": "#2f9c95"
      },
      "encoding": {
        "x": {
          "field": "fast_food_outlets",
          "type": "quantitative"
        },
        "y": {
          "field": "obesity_rate",
          "type": "quantitative"
        },
        "text": {
          "value": "More outlets,\nlower obesity"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.state == 'Tasmania'"
        }
      ],
      "mark": {
        "type": "text",
        "dx": 110,
        "dy": 95,
        "align": "left",
        "fontSize": 11,
        "fontWeight": 800,
        "color": "#4b345f"
      },
      "encoding": {
        "x": {
          "field": "fast_food_outlets",
          "type": "quantitative"
        },
        "y": {
          "field": "obesity_rate",
          "type": "quantitative"
        },
        "text": {
          "value": "Highest obesity,\nfew outlets"
        }
      }
    }

  ],

  "padding": {
    "top": 18,
    "right": 24,
    "bottom": 12,
    "left": 12
  }
}