{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Recommended vs Actual Serves",
    "subtitle": "Food groups are sorted by the largest gap from recommended daily serves.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "limit": 520,
    "subtitleLimit": 560,
    "offset": 10
  },
  "config": {
    "font": "Inter",
    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelLimit": 170,
      "labelPadding": 5
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "bottom",
      "titleColor": "#24302d",
      "labelColor": "#46524f",
      "titleFontSize": 12,
      "labelFontSize": 12,
      "labelLimit": 180,
      "symbolType": "circle",
      "symbolSize": 100,
      "titleLimit": 180,
      "padding": 2,
      "offset": 2
    }
  },
  "width": "container",
  "height": 350,
  "data": {
    "url": "data/cleaned/healthy_vs_actual_intake.csv"
  },
  "transform": [
    {
      "calculate": "abs(datum.gap)",
      "as": "Intake_Gap"
    },
    {
      "fold": [
        "recommended_serves",
        "actual_serves"
      ],
      "as": [
        "Measure",
        "Serves"
      ]
    },
    {
      "calculate": "datum.Measure == 'recommended_serves' ? 'Recommended serves' : 'Actual serves'",
      "as": "Serve_Type"
    }
  ],
  "mark": {
    "type": "bar",
    "cornerRadiusEnd": 3
  },
  "encoding": {
    "y": {
      "field": "food_group",
      "type": "nominal",
      "sort": {
        "field": "Intake_Gap",
        "order": "descending"
      },
      "title": "Food Group"
    },
    "x": {
      "field": "Serves",
      "type": "quantitative",
      "title": "Recommended vs Actual Daily Serves"
    },
    "color": {
      "field": "Serve_Type",
      "type": "nominal",
      "title": "Consumtion",
      "scale": {
        "domain": [
          "Recommended serves",
          "Actual serves"
        ],
        "range": [
          "#2e7d62",
          "#e66a35"
        ]
      }
    },
    "yOffset": {
      "field": "Serve_Type"
    },
    "tooltip": [
      {
        "field": "food_group",
        "title": "Food group"
      },
      {
        "field": "Serve_Type",
        "title": "Serve type"
      },
      {
        "field": "Serves",
        "title": "Daily serves",
        "format": ".1f"
      },
      {
        "field": "gap",
        "title": "Actual minus recommended",
        "format": "+.1f"
      }
    ]
  },

  "padding": {
    "top": 18,
    "right": 18,
    "bottom": 12,
    "left": 12
  }
}
