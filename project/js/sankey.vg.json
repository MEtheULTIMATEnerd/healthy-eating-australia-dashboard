{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Constraint Indicators by Disadvantage",
    "subtitle": "Separate prevalence measures by quintile; this is a comparison chart, not a person-level flow.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "limit": 520,
    "subtitleLimit": 660,
    "offset": 10
  },
  "config": {
    "font": "Inter",
    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelLimit": 190,
      "labelPadding": 5
    },
    "view": {
      "stroke": null
    },
    "legend": {
      "orient": "bottom",
      "titleColor": "#24302d",
      "labelColor": "#46524f",
      "titleFontSize": 12,
      "labelFontSize": 12,
      "labelLimit": 180,
      "symbolSize": 80,
      "titleLimit": 180,
      "padding": 8,
      "offset": 8
    }
  },
  "width": "container",
  "height": 390,
  "data": {
    "url": "data/cleaned/constraint_indicators.csv"
  },
  "encoding": {
    "y": {
      "field": "quintile",
      "type": "nominal",
      "sort": [
        "First quintile",
        "Second quintile",
        "Third quintile",
        "Fourth quintile",
        "Fifth quintile"
      ],
      "title": "Income/disadvantage quintile"
    },
    "x": {
      "field": "value",
      "type": "quantitative",
      "title": "Population prevalence (%)",
      "scale": {
        "domain": [
          0,
          45
        ]
      }
    },
    "color": {
      "field": "indicator",
      "type": "nominal",
      "title": "Indicator",
      "scale": {
        "domain": [
          "Zero physical activity",
          "Selected sweetened beverages",
          "Overweight"
        ],
        "range": [
          "#4b345f",
          "#e66a35",
          "#2f9c95"
        ]
      }
    },
    "yOffset": {
      "field": "indicator"
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 4,
        "height": 9
      },
      "encoding": {
        "tooltip": [
          {
            "field": "quintile",
            "title": "Income/disadvantage quintile"
          },
          {
            "field": "indicator",
            "title": "Indicator"
          },
          {
            "field": "value",
            "title": "Population prevalence (%)",
            "format": ".1f"
          },
          {
            "field": "source_measure",
            "title": "Source measure"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "dx": 5,
        "font": "Inter",
        "fontSize": 10,
        "fontWeight": 700,
        "color": "#35413d"
      },
      "encoding": {
        "text": {
          "field": "value",
          "format": ".1f"
        }
      }
    }
  ],
  "autosize": {
    "type": "pad",
    "contains": "padding"
  },
  "padding": {
    "top": 18,
    "right": 34,
    "bottom": 12,
    "left": 12
  }
}
