{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Discretionary Consumption by Age",
    "subtitle": "Selected discretionary foods as a share of daily energy intake.",
    "anchor": "start",
    "font": "Poppins",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "limit": 520,
    "subtitleLimit": 560,
    "offset": 10
  },

  "config": {
    "font": "Inter",

    "axis": {
      "labelColor": "#46524f",
      "titleColor": "#24302d",
      "gridColor": "#e7ebe8",
      "tickColor": "#d8ded9",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "titlePadding": 10,
      "labelLimit": 170,
      "labelPadding": 5
    },

    "view": {
      "stroke": null
    },

    "legend": {
      "orient": "bottom",
      "titleColor": "#24302d",
      "labelColor": "#46524f",
      "titleFontSize": 12,
      "labelFontSize": 11,
      "labelLimit": 300,
      "symbolSize": 100,
      "titleLimit": 180,
      "padding": 8,
      "offset": 8
    }
  },

  "width": "container",
  "height": 450,

  "data": {
    "url": "data/cleaned/discretionary_stream.csv"
  },

  "transform": [
    {
      "filter": "datum.category != null && datum.category != '' && datum.category != 'undefined'"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      }
    },
    {
      "data": {
        "values": [
          {
            "age_group": "50-64",
            "energy": 23,
            "label": "Sweet biscuit intake peaks among teenagers and older Australians"
          }
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 15,
        "fontWeight": 700,
        "fill": "#24302d",
        "align": "center"
      },
      "encoding": {
        "x": {
          "field": "age_group",
          "type": "ordinal"
        },
        "y": {
          "field": "energy",
          "type": "quantitative"
        },
        "text": {
          "field": "label"
        }
      }
    }
  ],

  "encoding": {
    "x": {
      "field": "age_group",
      "type": "ordinal",
      "sort": [
        "2-4",
        "5-11",
        "12-17",
        "18-29",
        "30-49",
        "50-64",
        "65-74",
        "75+"
      ],
      "title": "Age group"
    },

    "y": {
      "field": "energy_percent",
      "type": "quantitative",
      "stack": "center",
      "title": "Share of daily energy (%)"
    },

    "color": {
      "field": "category",
      "type": "nominal",
      "title": "Discretionary food group",

      "scale": {
        "domain": [
          "Cakes and desserts",
          "Cereal-based discretionary foods",
          "Fats and oils",
          "Pastries",
          "Soft drinks",
          "Sweet biscuits"
        ],

        "range": [
          "#e66a35",
          "#f0aa4b",
          "#8e5b48",
          "#5c4b51",
          "#2f9c95",
          "#c7432f"
        ]
      }
    },

    "tooltip": [
      {
        "field": "age_group",
        "title": "Age group"
      },
      {
        "field": "category",
        "title": "Food group"
      },
      {
        "field": "energy_percent",
        "title": "Share of daily energy (%)",
        "format": ".1f"
      }
    ]
  },

  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },

  "padding": {
    "top": 18,
    "right": 18,
    "bottom": 12,
    "left": 12
  }
}